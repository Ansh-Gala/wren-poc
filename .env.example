# Copy to .env and fill in real values. .env is gitignored and never committed.
# There is deliberately NO ANTHROPIC_API_KEY here: this project reaches Claude
# only through the locally installed Claude Code CLI, which manages its own auth.

# ---------------------------------------------------------------- PostgreSQL
# The database holding the tms_* views this application queries.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# The role generated SQL actually runs as. Grant it SELECT and nothing else.
# pipeline/safety.py rejects writes before they are sent, but a read-only
# grant is what makes that belt-and-braces rather than the only defence.
DATABASE_READONLY_USER=
DATABASE_READONLY_PASSWORD=

# Hard ceiling on any single generated query (milliseconds).
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------- Claude Code CLI
CLAUDE_CLI_COMMAND=claude
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_SECONDS=180

# Which LLM answers. 'cli' is the local Claude Code install and the only
# provider this deployment supports; the server refuses to start otherwise.
LLM_PROVIDER=cli

# Lean mode inlines the schema, business rules and examples into a cached
# system prompt and runs a single turn with no MCP round-trips. It is the only
# mode this branch ships: the MCP path needs wren_setup, which lives on
# develop, so setting this false will not start.
CLI_LEAN=true

DEBUG=false
