# Copy this file to .env and fill in every <placeholder>.
# .env is never committed. Restart the server after each change.

# Business Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=<business database, e.g. vector_pro>
DATABASE_READONLY_USER=<read-only login, e.g. wren_ro>
DATABASE_READONLY_PASSWORD=<password>
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Product Metadata
METADATA_DIR=<metadata folder, e.g. products/vector_pro/metadata; empty = metadata/ (Arvind TMS)>
FRESHNESS_TABLES=
FRESHNESS_MESSAGE=This data is not updated in real time. Last updated 6 hours ago.

# Chat History Database
HISTORY_DATABASE_HOST=localhost
HISTORY_DATABASE_PORT=5432
HISTORY_DATABASE_NAME=<chat database, e.g. wren_chatbot>
HISTORY_DATABASE_USER=<chat login, e.g. wren_chat_writer>
HISTORY_DATABASE_PASSWORD=<password>
CHAT_TABLE_PREFIX=py_
SAVE_CHATS=true
MONTHLY_TOKEN_LIMIT=0

# LLM
# LLM_PROVIDER: cli (Claude Code on this machine), anthropic (Claude API) or openai (OpenAI API)
LLM_PROVIDER=cli
CLAUDE_CLI_COMMAND=claude
CLAUDE_MODEL=sonnet
CLAUDE_EFFORT_LEVEL=medium
CLAUDE_TIMEOUT_SECONDS=180
CLAUDE_CONFIG_DIR=<the chatbot's own Claude Code folder, e.g. C:\Users\<you>\.claude-wren>
CLI_LEAN=true
CLI_POOL_SIZE=4
CLI_POOL_WARMUP_SECONDS=3.0

# Claude API (LLM_PROVIDER=anthropic; pip install anthropic)
# ANTHROPIC_API_KEY=<key>
# ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI API (LLM_PROVIDER=openai; pip install openai)
# OPENAI_API_KEY=<key>
# OPENAI_MODEL=gpt-5.6-luna

# Behaviour
STREAM_ANSWERS=false
PII_ALIASING=false
PII_MODEL=fastino/gliner2.5-small-v1
PII_THRESHOLD=0.5
PII_CONCURRENCY=4

# Owner Login (setup only)
DATABASE_USER=<owner login, e.g. postgres>
DATABASE_PASSWORD=<password>
