# Copy to .env and fill in real values. .env is gitignored and never committed.
# The default model transport is the local Claude Code CLI, which manages its
# own auth. ANTHROPIC_API_KEY below is read only when LLM_PROVIDER=anthropic,
# and is never passed to the CLI.

# ------------------------------------------- Database 1: business (PostgreSQL)
# The database holding the tms_* views this application queries. Which views
# the chatbot may use is NOT set here: see metadata/schema_description.yaml
# (docs/two-databases.md, "Available views").
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=<business database>
DATABASE_USER=<owner login, used only by setup scripts>
DATABASE_PASSWORD=<password>

# The role generated SQL actually runs as. Grant it SELECT and nothing else.
# pipeline/safety.py rejects writes before they are sent, but a read-only
# grant is what makes that belt-and-braces rather than the only defence.
DATABASE_READONLY_USER=<read-only login, e.g. wren_ro>
DATABASE_READONLY_PASSWORD=<password>

# Hard ceiling on any single generated query (milliseconds).
DATABASE_STATEMENT_TIMEOUT_MS=100000

# ------------------------------------------------- Command authorization
# Every request names its user in the body ("user_id": 12). There is no
# default user. Asking a question -- which runs one read-only SELECT -- needs
# one of these TMS (Drupal) roles, read from vf_user__roles in database 1.
# Comma separated. "authenticated" means any user the database knows.
# Empty means nobody may ask.
CHATBOT_RUN_ROLES=wcms_admin,ticket_owner

# The "not live" note. A query reading one of these tables (comma separated)
# shows this sentence above its rows. Leave either empty to turn it off.
FRESHNESS_TABLES=vf_report_task_summary
FRESHNESS_MESSAGE=This data is not updated in real time. Last updated 6 hours ago.

# --------------------------------- Database 2: chats (persistence identity)
# A database of its own holding py_sql_chat and py_sql_chat_turn, made by
# database/migrations/2026-10-19_chat_database.sql. Every chat write uses this
# login, which may only SELECT/INSERT/UPDATE those two tables. Nothing here
# falls back to DATABASE_*; it must not be the business database, nor either
# login above. With no name or no user, chats are not saved.
HISTORY_DATABASE_HOST=localhost
HISTORY_DATABASE_PORT=5432
HISTORY_DATABASE_NAME=<chat database, e.g. wren_chatbot>
HISTORY_DATABASE_USER=<chat writer login, e.g. wren_chat_writer>
HISTORY_DATABASE_PASSWORD=<password>
CHAT_TABLE_PREFIX=py_

# Effective tokens all users together may spend per calendar month; 0 is no
# limit. Counted from the saved chats, so it needs them.
MONTHLY_TOKEN_LIMIT=0

# ---------------------------------------------------------- Claude Code CLI
CLAUDE_CLI_COMMAND=claude
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_SECONDS=500

# Which LLM answers: cli (the local Claude Code install, the default),
# anthropic, openai, groq or gemini -- the transports the Drupal port offers.
# An API provider needs its key; the server refuses to start without it.
LLM_PROVIDER=cli

# LLM_PROVIDER=anthropic only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Lean mode inlines the schema, business rules and examples into a cached
# system prompt and runs a single turn with no MCP round-trips. It is the only
# mode this branch ships: the MCP path needs wren_setup, which lives on
# develop, so setting this false will not start.
CLI_LEAN=true

# POST /ask/stream sends the table before the answer. false sends only the
# answer, as Drupal's stream_answers switch does.
STREAM_ANSWERS=true

DEBUG=false
