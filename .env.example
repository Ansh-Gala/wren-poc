# Copy to .env and fill in real values. .env is gitignored and never committed.
# There is deliberately NO ANTHROPIC_API_KEY here: this project reaches Claude
# only through the locally installed Claude Code CLI, which manages its own auth.

# ---------------------------------------------------------------- PostgreSQL
# Owner account, used only by scripts/setup_demo.py to create schema + seed.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=wren_demo
DATABASE_USER=postgres
DATABASE_PASSWORD=

# Read-only role the benchmark uses to execute generated SQL.
# Created automatically by scripts/setup_demo.py.
DATABASE_READONLY_USER=wren_ro
DATABASE_READONLY_PASSWORD=wren_ro_local_only

# Hard ceiling on any single generated query (milliseconds).
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------- Wren
# Where the four knowledge configurations (A/B/C/D) are generated.
WREN_PROJECT_ROOT=./wren_projects
WREN_HOME=./wren_projects/.wren_home

# grep = keyword recall, zero extra deps.
# lancedb = semantic recall, needs the wrenai[memory] extra. Preferred.
WREN_MEMORY_BACKEND=lancedb

# ---------------------------------------------------------- Claude Code CLI
CLAUDE_CLI_COMMAND=claude
CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT_SECONDS=180

# Which LLM answers. 'cli' is the local Claude Code install and is the only
# provider this project is measured against; every benchmark figure on record
# was produced with the two settings below.
LLM_PROVIDER=cli

# Lean mode inlines the schema, business rules and examples into a cached
# system prompt and runs a single turn with no MCP round-trips. Leaving this
# false silently switches to the MCP path, which needs `wren serve mcp`
# running and costs roughly three times the context per question.
CLI_LEAN=true

# -----------------------------------------------------------------  Benchmark
# Which knowledge configuration to run by default: A, B, C or D.
BENCHMARK_CONFIG=D
# strict    = wren serve mcp --no-connect  (row tools never registered)
# validated = wren connected, row tools denied at the CLI + read-only PG role
BENCHMARK_PRIVACY_MODE=strict

DEBUG=true
